{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run with login argument",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["login"],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug current file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "args": ["login"]
        }
    ]
}